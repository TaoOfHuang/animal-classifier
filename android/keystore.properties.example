# ── 发布签名配置模板 ────────────────────────────────────────────────
# 用法：复制本文件为同目录下的 keystore.properties，填入真实值。
#   cp android/keystore.properties.example android/keystore.properties
#
# keystore.properties 已在 .gitignore 中忽略，不会提交到版本库。
# 请务必单独备份 keystore 文件与密码，丢失后无法再更新已上架的应用。

# keystore 文件路径，相对 android/app/ 目录解析
storeFile=release.keystore

# keystore 密码
storePassword=your_store_password

# key 别名（生成 keystore 时用 -alias 指定的名字）
keyAlias=animal-classifier

# key 密码（PKCS12 格式通常与 storePassword 相同）
keyPassword=your_key_password
