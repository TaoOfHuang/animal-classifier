PORT=3000

# ── API Token (protect /api/recognize) ──────────────────────────────
# Set to a random string to require token.  Leave empty for no-auth mode.
API_TOKEN=animal-classifier-xyz-123

# ── AI Provider Configuration ──────────────────────────────────────
# AI provider type: openai | ollama | openrouter | custom
AI_PROVIDER=ollama

# API endpoint (base URL) — append /v1/chat/completions at runtime
AI_BASE_URL=http://192.168.5.3:1234

# API key (leave empty for providers that don't require one, e.g. local Ollama)
AI_API_KEY=

# Model identifier
AI_MODEL=qwen/qwen3.6-35b-a3b

# ── Rate Limiting ───────────────────────────────────────────────────
# Maximum /api/recognize calls per day (0 = unlimited)
AI_RECOGNIZE_DAILY_LIMIT=100

IUCN_API_TOKEN=
UNSPLASH_ACCESS_KEY=owXiMjCjNG-o2Ebr5R6vNqgmW9iM8a5oMIFYix1L44o
PEXELS_API_KEY=
