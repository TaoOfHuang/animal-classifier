PORT=3000

# ── API Token (protect /api/recognize) ──────────────────────────────
# Set to a random string to require token.  Leave empty for no-auth mode.
API_TOKEN=animal-classifier-xyz-123

# ── AI Provider Configuration ──────────────────────────────────────
# AI provider type: openai | ollama | openrouter | deepseek | bigmodel | custom
AI_PROVIDER=deepseek

# API endpoint (base URL) — append /chat/completions at runtime
AI_BASE_URL=https://api.deepseek.com

# API key — DeepSeek 的 Key 与智谱不通用，请在 platform.deepseek.com 申请后填入
AI_API_KEY=<your-deepseek-api-key>

# Model identifier — 图片识别需要支持视觉输入的模型
AI_MODEL=deepseek-flash

# ── Rate Limiting ───────────────────────────────────────────────────
# Maximum /api/recognize calls per day (0 = unlimited)
AI_RECOGNIZE_DAILY_LIMIT=100

# ── 分类信息（ITIS）──────────────────────────────────────────────────
# ITIS 是公开端点，**不需要 token**，这里没有对应配置项。
# 学名检索 / 完整谱系均走 https://www.itis.gov/ITISWebService/jsonservice

# ── 濒危信息（IUCN Red List）─────────────────────────────────────────
# 数据源：static（本地离线数据集，默认）| iucn_v4（在线 v4 API，需下方 token）
# 默认 static 的原因见 docs/plans/2026-09-13-itis-iucn-integration.md「前置决策 1」：
# IUCN ToU 对 mobile app 场景有限制，在线 v4 只作为可切换选项。
# 注意：填了非法值会**直接启动失败**（fail fast），不会静默退回默认值。
CONSERVATION_SOURCE=static

# IUCN v4 token。v3 已于 2025-03-27 下线且账号不迁移，需到 api.iucnredlist.org 重新注册。
# 仅 CONSERVATION_SOURCE=iucn_v4 时需要；为空时启动期只打印告警，不阻断启动。
IUCN_API_TOKEN=

# ── 图片源（可选）───────────────────────────────────────────────────
UNSPLASH_ACCESS_KEY=xyz
PEXELS_API_KEY=
