PORT=3000

# ── 设备令牌鉴权 ────────────────────────────────────────────────────
# /api/recognize 现在要求「设备令牌」：客户端首次启动时调 POST /api/auth/device
# 用 deviceId 换取。**不再有共享 API_TOKEN，也没有「无鉴权模式」。**
# 设计见 docs/plans/2026-09-18-device-token-auth.md
#
# SQLite 数据库文件路径（需纳入备份；Docker 部署时挂载卷）
DB_PATH=./data/app.sqlite

# 管理员令牌：用于 POST /api/auth/revoke 封禁设备。
# 生成方式：openssl rand -hex 32。留空则该端点返回 503，不会裸奔。
ADMIN_TOKEN=

# ── AI Provider Configuration ──────────────────────────────────────
# AI provider type: openai | ollama | openrouter | deepseek | bigmodel | custom
AI_PROVIDER=deepseek

# API endpoint (base URL) — append /chat/completions at runtime
AI_BASE_URL=https://api.deepseek.com

# API key — DeepSeek 的 Key 与智谱不通用，请在 platform.deepseek.com 申请后填入
AI_API_KEY=<your-deepseek-api-key>

# Model identifier — 图片识别需要支持视觉输入的模型
AI_MODEL=deepseek-flash

# ── 三层限额 ────────────────────────────────────────────────────────
# ① 单设备每日识别上限（0 = 不限）—— 公平分配：一台设备刷不爆别人
DEVICE_DAILY_LIMIT=20

# ② 全局每日识别上限（0 = 不限）—— 财务保险丝，所有非白名单设备共享。
#    这是唯一不依赖客户端可信度的机制：无论对方换多少设备、伪造多少身份，
#    一天的总额就那么点。GLOBAL_DAILY_LIMIT 才是本方案真正的安全边界。
GLOBAL_DAILY_LIMIT=500

# ③ 注册节流与设备总量 —— 抬高「变出新身份」的成本
# 同一 IP 每小时最多注册次数（0 = 不限）
REGISTER_RATE_LIMIT_PER_HOUR=3
# 设备总数上限（0 = 不限）
MAX_DEVICE_COUNT=2000

# 管理员设备白名单：不参与全局配额计算（多个 deviceId 用逗号分隔）。
# 避免全局限额耗尽时把自己也挡在门外。
WHITELIST_DEVICE_IDS=

# ── 分类信息（ITIS）──────────────────────────────────────────────────
# ITIS 是公开端点，**不需要 token**，这里没有对应配置项。
# 学名检索 / 完整谱系均走 https://www.itis.gov/ITISWebService/jsonservice

# ── 濒危信息（IUCN Red List）─────────────────────────────────────────
# 数据源：static（本地离线数据集，默认）| iucn_v4（在线 v4 API，需下方 token）
# 默认 static 的原因见 docs/plans/2026-09-13-itis-iucn-integration.md「前置决策 1」：
# IUCN ToU 对 mobile app 场景有限制，在线 v4 只作为可切换选项。
# 注意：填了非法值会**直接启动失败**（fail fast），不会静默退回默认值。
CONSERVATION_SOURCE=static

# IUCN v4 token。v3 已于 2025-03-27 下线且账号不迁移，需到 api.iucnredlist.org 重新注册。
# 仅 CONSERVATION_SOURCE=iucn_v4 时需要；为空时启动期只打印告警，不阻断启动。
IUCN_API_TOKEN=

# ── 图片源（可选）───────────────────────────────────────────────────
UNSPLASH_ACCESS_KEY=xyz
PEXELS_API_KEY=
